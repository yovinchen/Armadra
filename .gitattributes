# Line endings are part of the build here, not a preference.
#
# The Windows runner checks out with `core.autocrlf=true` unless told
# otherwise, and `prettier --check` compares bytes, so a CRLF working copy
# fails it. Normalising to LF in the repository and on checkout keeps the
# three platforms byte-identical.
* text=auto eol=lf

# Binary assets are never text, whatever the heuristic decides.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.bin binary
*.db binary
