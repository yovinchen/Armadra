{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Coding Canvas",
  "version": "0.1.0",
  "identifier": "dev.aicodingcanvas.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Coding Canvas",
        "width": 1440,
        "height": 920,
        "minWidth": 320,
        "minHeight": 640,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:43120 ws://127.0.0.1:43120; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["../../../target/release/ai-coding-canvas-runtime"]
  }
}
