{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "vitest.live.config.mts"
  ],
  "exclude": ["node_modules", "out", "release", "resources"]
}
