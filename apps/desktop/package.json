{
  "name": "@armadra/desktop",
  "description": "Armadra desktop shell",
  "homepage": "https://github.com/yovinchen/Armadra",
  "author": {
    "name": "YoVinchen",
    "email": "gzh298255@gmail.com"
  },
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "predev": "node scripts/ensure-electron.mjs && pnpm prepare:host --native",
    "prepare:host": "node scripts/prepare-host.mjs",
    "stage:binaries": "node scripts/stage-binaries.mjs",
    "stage:binaries-placeholders": "node scripts/stage-binaries.mjs --placeholders",
    "dist": "node scripts/dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/ensure-node-pty.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@armadra/protocol": "workspace:*",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "42.11.6",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "js-yaml": "5.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
