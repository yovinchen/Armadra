{
  "version": "0.0.1",
  "configurations": [
    {
      "$comment": "This entry pins a port because a launch configuration cannot read endpoints.json before the process exists. It is declared with --listen rather than relying on the Runtime's compatibility default, and the web entries below reach the Runtime through the Vite proxy, which does read endpoints.json.",
      "name": "runtime",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "armadra-runtime",
        "--",
        "--listen",
        "tcp:127.0.0.1:43124"
      ],
      "port": 43124,
      "url": "http://127.0.0.1:43124"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1421",
        "--host",
        "localhost"
      ],
      "port": 1421,
      "url": "http://localhost:1421"
    },
    {
      "name": "web-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1422",
        "--host",
        "localhost"
      ],
      "port": 1422,
      "url": "http://localhost:1422"
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "1423",
        "--host",
        "localhost"
      ],
      "port": 1423,
      "url": "http://localhost:1423"
    }
  ]
}
