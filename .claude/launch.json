{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "runtime",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "armadra-runtime"],
      "port": 43120,
      "url": "http://127.0.0.1:43120"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1421",
        "--host",
        "localhost"
      ],
      "port": 1421,
      "url": "http://localhost:1421"
    },
    {
      "name": "web-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1422",
        "--host",
        "localhost"
      ],
      "port": 1422,
      "url": "http://localhost:1422"
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "1423",
        "--host",
        "localhost"
      ],
      "port": 1423,
      "url": "http://localhost:1423"
    }
  ]
}
