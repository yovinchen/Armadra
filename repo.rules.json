{
  "$comment": "docs/design/repository-structure.md §3 的机器可读版本，由 tools/repo-check.mjs 执行。",
  "root": [
    ".claude",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".prettierignore",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "apps",
    "armadra.sh",
    "assets",
    "docs",
    "migrations.lock",
    "package.json",
    "packages",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "repo.rules.json",
    "tools",
    "tsconfig.base.json"
  ],
  "blacklist": [
    "output/",
    "dist/",
    "out/",
    "apps/desktop/release/",
    ".idea/",
    ".playwright-cli/",
    "*.db",
    "*.db-shm",
    "*.db-wal"
  ],
  "docs": {
    "root": "docs",
    "index": "docs/README.md",
    "directoryOnly": ["history", "research"]
  },
  "links": {
    "include": [
      "*.md",
      "apps/",
      "assets/",
      "docs/",
      "packages/",
      "tools/"
    ],
    "exclude": [".claude/"]
  },
  "naming": [
    {
      "directory": "packages",
      "manifest": "package.json",
      "prefix": "@armadra/"
    }
  ],
  "fileSize": {
    "max": 1500,
    "roots": ["apps", "packages", "tools"],
    "extensions": [".ts", ".tsx", ".mjs", ".js"],
    "excludeSegments": ["/gen/", "/node_modules/"],
    "exemptions": []
  },
  "migrations": {
    "lock": "migrations.lock",
    "$comment": "迁移只有一个来源：core 的 db/migrations。0001–0020 是一条连续序列，lock 守住它们的字节。",
    "sources": [
      {
        "path": "apps/desktop/src/core/db/migrations",
        "kind": "directory"
      }
    ]
  }
}
