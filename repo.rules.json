{
  "$comment": "docs/design/repository-structure.md §3 的机器可读版本，由 tools/repo-check.mjs 执行。",
  "root": [
    ".claude",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".prettierignore",
    "AGENTS.md",
    "CLAUDE.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "apps",
    "armadra.sh",
    "assets",
    "crates",
    "docs",
    "migrations.lock",
    "package.json",
    "packages",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "proto",
    "repo.rules.json",
    "tools",
    "tsconfig.base.json"
  ],
  "blacklist": [
    "output/",
    "dist/",
    "target/",
    ".idea/",
    ".playwright-cli/",
    "*.db",
    "*.db-shm",
    "*.db-wal"
  ],
  "docs": {
    "root": "docs",
    "index": "docs/README.md",
    "directoryOnly": ["history", "research"]
  },
  "links": {
    "include": [
      "*.md",
      "apps/",
      "assets/",
      "crates/",
      "docs/",
      "packages/",
      "proto/",
      "tools/"
    ],
    "exclude": [".claude/"],
    "ignoreTargets": []
  },
  "naming": [
    {
      "directory": "packages",
      "manifest": "package.json",
      "prefix": "@armadra/"
    },
    {
      "directory": "crates",
      "manifest": "Cargo.toml",
      "prefix": "armadra-"
    }
  ],
  "fileSize": {
    "max": 1500,
    "roots": ["apps", "crates", "packages", "tools"],
    "extensions": [".rs", ".ts", ".tsx", ".go", ".mjs", ".js"],
    "excludeSegments": ["/gen/", "/node_modules/"],
    "exemptions": []
  },
  "migrations": {
    "lock": "migrations.lock",
    "sources": [
      {
        "path": "apps/runtime/migrations",
        "kind": "directory"
      },
      {
        "path": "apps/host/internal/migration/legacy",
        "kind": "directory"
      },
      {
        "path": "apps/host/internal/storage/schema.go",
        "kind": "go-constants",
        "pattern": "const (schemaV\\d+)"
      }
    ]
  },
  "proto": {
    "schemas": "proto/armadra/v1",
    "fixtures": "proto/fixtures",
    "goTests": "apps/host/gen/armadra/v1",
    "rustTests": "crates/protocol/tests",
    "tsTests": "packages/protocol/test"
  }
}
