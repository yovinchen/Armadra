{
  "name": "armadra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "host:bootstrap-smoke": "node scripts/host-bootstrap-smoke.mjs",
    "host:lifecycle-smoke": "node scripts/host-lifecycle-smoke.mjs",
    "handoff:read-smoke": "node scripts/handoff-read-smoke.mjs",
    "host:smoke": "node scripts/host-smoke.mjs",
    "canvas:e2e": "node scripts/canvas-ownership-e2e.mjs",
    "github:e2e": "node scripts/github-e2e.mjs",
    "protocol:generate": "node scripts/protocol.mjs generate",
    "protocol:check": "node scripts/protocol.mjs check",
    "protocol:test": "node scripts/protocol.mjs test",
    "protocol:fixtures": "node scripts/protocol.mjs fixtures",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @armadra/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:rust": "pnpm --filter @armadra/desktop prepare:sidecar && cargo check --workspace"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
