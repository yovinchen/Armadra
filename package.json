{
  "name": "armadra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "host:bootstrap-smoke": "node tools/host-bootstrap-smoke.mjs",
    "host:lifecycle-smoke": "node tools/host-lifecycle-smoke.mjs",
    "handoff:read-smoke": "node tools/handoff-read-smoke.mjs",
    "agent:smoke": "node tools/agent-channel-smoke.mjs",
    "host:smoke": "node tools/host-smoke.mjs",
    "canvas:e2e": "node tools/canvas-ownership-e2e.mjs",
    "ownership:e2e": "node tools/ownership-e2e.mjs",
    "github:e2e": "node tools/github-e2e.mjs",
    "protocol:generate": "node tools/protocol.mjs generate",
    "protocol:check": "node tools/protocol.mjs check",
    "protocol:test": "node tools/protocol.mjs test",
    "protocol:fixtures": "node tools/protocol.mjs fixtures",
    "repo:check": "node tools/repo-check.mjs",
    "repo:test": "node --test tools/repo-check.test.mjs",
    "ci:workflows": "node tools/ci/validate-workflows.mjs",
    "release:check": "node tools/release/version.mjs check",
    "release:dry-run": "node tools/release/dry-run.mjs",
    "release:test": "node --test tools/release/*.test.mjs tools/ci/*.test.mjs",
    "libs:build": "pnpm --filter @armadra/protocol --filter @armadra/shared --filter @armadra/host-client build",
    "check": "pnpm libs:build && pnpm format:check && pnpm typecheck && pnpm protocol:check && pnpm repo:check && pnpm ci:workflows && pnpm release:check",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @armadra/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:rust": "pnpm --filter @armadra/desktop prepare:sidecar && cargo check --workspace"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
